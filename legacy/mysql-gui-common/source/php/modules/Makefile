install-commondataDATA: $(commondata_DATA)
	@$(NORMAL_INSTALL)
	test -z "$(commondatadir)" || $(mkdir_p) "$(DESTDIR)$(commondatadir)"
	@list='$(commondata_DATA)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f=$(am__strip_dir) \
	  echo " $(commondataDATA_INSTALL) '$$d$$p' '$(DESTDIR)$(commondatadir)/$$f'"; \
	  $(commondataDATA_INSTALL) "$$d$$p" "$(DESTDIR)$(commondatadir)/$$f"; \
	done

uninstall-commondataDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(commondata_DATA)'; for p in $$list; do \
	  f=$(am__strip_dir) \
	  echo " rm -f '$(DESTDIR)$(commondatadir)/$$f'"; \
	  rm -f "$(DESTDIR)$(commondatadir)/$$f"; \
	done
