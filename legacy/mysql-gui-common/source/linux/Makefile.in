all: all-am

.SUFFIXES:
.SUFFIXES: .cc .cpp .lo .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign  source/linux/Makefile'; \
	cd $(top_srcdir) && \
	  $(AUTOMAKE) --foreign  source/linux/Makefile
.PRECIOUS: Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__depfiles_maybe);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

clean-noinstLIBRARIES:
	-test -z "$(noinst_LIBRARIES)" || rm -f $(noinst_LIBRARIES)
libmacommongui.a: $(libmacommongui_a_OBJECTS) $(libmacommongui_a_DEPENDENCIES) 
	-rm -f libmacommongui.a
	$(libmacommongui_a_AR) libmacommongui.a $(libmacommongui_a_OBJECTS) $(libmacommongui_a_LIBADD)
	$(RANLIB) libmacommongui.a
libqbcommongui.a: $(libqbcommongui_a_OBJECTS) $(libqbcommongui_a_DEPENDENCIES) 
	-rm -f libqbcommongui.a
	$(libqbcommongui_a_AR) libqbcommongui.a $(libqbcommongui_a_OBJECTS) $(libqbcommongui_a_LIBADD)
	$(RANLIB) libqbcommongui.a
libwbcommongui.a: $(libwbcommongui_a_OBJECTS) $(libwbcommongui_a_DEPENDENCIES) 
	-rm -f libwbcommongui.a
	$(libwbcommongui_a_AR) libwbcommongui.a $(libwbcommongui_a_OBJECTS) $(libwbcommongui_a_LIBADD)
	$(RANLIB) libwbcommongui.a
libwboardcommon.a: $(libwboardcommon_a_OBJECTS) $(libwboardcommon_a_DEPENDENCIES) 
	-rm -f libwboardcommon.a
	$(libwboardcommon_a_AR) libwboardcommon.a $(libwboardcommon_a_OBJECTS) $(libwboardcommon_a_LIBADD)
	$(RANLIB) libwboardcommon.a

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

