install-languagesDATA: $(languages_DATA)
	@$(NORMAL_INSTALL)
	$(mkinstalldirs) $(DESTDIR)$(languagesdir)
	@list='$(languages_DATA)'; for p in $$list; do \
	  if test -f "$$p"; then d=; else d="$(srcdir)/"; fi; \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " $(languagesDATA_INSTALL) $$d$$p $(DESTDIR)$(languagesdir)/$$f"; \
	  $(languagesDATA_INSTALL) $$d$$p $(DESTDIR)$(languagesdir)/$$f; \
	done

uninstall-languagesDATA:
	@$(NORMAL_UNINSTALL)
	@list='$(languages_DATA)'; for p in $$list; do \
	  f="`echo $$p | sed -e 's|^.*/||'`"; \
	  echo " rm -f $(DESTDIR)$(languagesdir)/$$f"; \
	  rm -f $(DESTDIR)$(languagesdir)/$$f; \
	done
