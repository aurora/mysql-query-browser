# SPDX-License-Identifier: GPL-2.0-or-later
# The Pascal toolchain of the "freepascal" distrobox (tools/distrobox-setup.sh) as a plain image, for building the
# AppImage where there is no distrobox (CI). Used by tools/package-appimage.sh when QBR_FPC_IMAGE is set. Only what
# building the program needs (with both widgetsets): no Xvfb or test tools (the lazarus package brings the IDE's packages the project
# uses). Fedora 44 ships Lazarus 4.8.
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install fpc lazarus lazarus-lcl-gtk2 lazarus-lcl-qt6 \
      gcc binutils glib2-devel libxml2-devel pcre-devel mariadb-connector-c-devel \
      python3 python-unversioned-command mingw64-binutils mingw64-cpp \
 && dnf clean all
