#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Entry point of the AppImage: points GTK2, the image loaders and the MySQL client library at the bundled copies
# (Qt finds its plugins through usr/bin/qt.conf).
HERE="$(dirname "$(readlink -f "$0")")"
export MARIADB_PLUGIN_DIR="$HERE/usr/lib/mariadb/plugin"

if [ -d "$HERE/usr/lib/qt6" ]; then
  exec "$HERE/usr/bin/querymole" "$@"
fi

# the loader cache lists absolute paths: write it for the place the image is mounted at
RUN="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/querymole-appimage-$(id -u)"
mkdir -p "$RUN" && chmod 700 "$RUN"
sed "s|@APPDIR@|$HERE|g" "$HERE/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache.in" > "$RUN/loaders.cache"

export GDK_PIXBUF_MODULE_FILE="$RUN/loaders.cache"
export GTK_PATH="$HERE/usr/lib/gtk-2.0${GTK_PATH:+:$GTK_PATH}"
export GDK_BACKEND=x11            # GTK2 only speaks X11: XWayland on a Wayland desktop

exec "$HERE/usr/bin/querymole" "$@"
