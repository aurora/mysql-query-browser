<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="None"/>
      <Title Value="QueryMole"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="laz.virtualtreeview_package"/>
      </Item>
      <Item>
        <PackageName Value="SynEdit"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="qbr.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/querymole"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="$(ProjOutDir);src;forms"/>
      <OtherUnitFiles Value="compat;src;forms;../bindings;../third_party/velopack-pas/src"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)-$(LCLWidgetType)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
    <Other>
      <!-- String<->WideString conversions are intended: String is UTF-8 (ADR-0007) -->
      <CustomOptions Value="-vm4104,4105 -gl"/>
      <!-- src/RevivalInfo.inc is generated from ../VERSION (not in git), also for builds from the IDE or lazbuild -->
      <ExecuteBefore>
        <Command Value="$(QBR_PYTHON) $(ProjPath)../tools/gen_version.py"/>
      </ExecuteBefore>
    </Other>
    <Linking>
      <Options>
        <Win32>
          <GraphicApplication Value="True"/>
        </Win32>
      </Options>
    </Linking>
    <!-- Python 3 for the step above: macOS has no unversioned python (as in build.sh) -->
    <Conditionals Value="if TargetOS = 'darwin' then QBR_PYTHON := 'python3' else QBR_PYTHON := 'python';"/>
    <BuildMacros>
      <Count Value="1"/>
      <Item1>
        <Identifier Value="QBR_PYTHON"/>
        <Description Value="Python 3 interpreter that runs tools/gen_version.py before compiling"/>
      </Item1>
    </BuildMacros>
  </CompilerOptions>
</CONFIG>
