object TabHeaderFrame: TTabHeaderFrame
  Left = 0
  Top = 0
  Width = 699
  Height = 17
  Color = clWhite
  ParentColor = False
  TabOrder = 0
  TabStop = True
  OnResize = TntFrameResize
  object TabHeaderPopupMenu: TPopupMenu
    OnPopup = TabHeaderPopupMenuPopup
    Left = 26
    object RenameTabsheetMI: TMenuItem
      Caption = 'Rename Tabsheet'
      OnClick = RenameTabsheetMIClick
    end
    object N1: TMenuItem
      Caption = '-'
    end
    object CloseTabsheetMI: TMenuItem
      Caption = 'Close Tabsheet'
      OnClick = CloseTabsheetMIClick
    end
  end
end
