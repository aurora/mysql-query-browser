{ File dialogs for the TNT aliases (TntDialogs, generated by tools/gen_tnt_shims.py).

  The original writes its filters the Windows way, with the pattern in the description too:
  'JSON Lines File (*.jsonl)|*.jsonl'. The LCL's Qt6 widgetset appends the pattern to every description itself and
  turns the parentheses already there into full-width ones, so Qt showed "JSON Lines File（*.jsonl）(*.jsonl)".
  Under Qt6 these dialogs drop a trailing "(...)" from each description while they are shown; everywhere else they
  are the LCL's dialogs unchanged. }
unit QBFileDialogs;

{$mode objfpc}{$H+}

interface

uses
  Classes, SysUtils, Dialogs, FileFilters;

type
  TQBOpenDialog = class(TOpenDialog)
  public
    function Execute: Boolean; override;
  end;

  TQBSaveDialog = class(TSaveDialog)
  public
    function Execute: Boolean; override;
  end;

implementation

function TQBOpenDialog.Execute: Boolean;
{$IFDEF LCLQT6}
var
  Saved: String;
{$ENDIF}
begin
  {$IFDEF LCLQT6}
  Saved := Filter;
  Filter := FilterWithoutPatternsInDescriptions(Saved);
  try
    Result := inherited Execute;
  finally
    Filter := Saved;
  end;
  {$ELSE}
  Result := inherited Execute;
  {$ENDIF}
end;

function TQBSaveDialog.Execute: Boolean;
{$IFDEF LCLQT6}
var
  Saved: String;
{$ENDIF}
begin
  {$IFDEF LCLQT6}
  Saved := Filter;
  Filter := FilterWithoutPatternsInDescriptions(Saved);
  try
    Result := inherited Execute;
  finally
    Filter := Saved;
  end;
  {$ELSE}
  Result := inherited Execute;
  {$ENDIF}
end;

end.
