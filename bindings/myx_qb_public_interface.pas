    Create(ConvertString(ARecord^.id), ConvertString(ARecord^.select_type), ConvertString(ARecord^.table), ConvertString(ARecord^.join_type), ConvertString(ARecord^.key), ConvertString(ARecord^.key_len), ConvertString(ARecord^.ref), ConvertString(ARecord^.rows), ConvertString(ARecord^.extra))
  else
    Create('', '', '', '', '', '', '', '', '');
  Self.record_pointer := nil;
  if ARecord <> nil then
