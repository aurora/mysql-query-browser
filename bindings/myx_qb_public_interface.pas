  Self.Fselect_type := select_type;
  Self.Ftable := table;
  Self.Fjoin_type := join_type;
  Self.Fkey := key;
  Self.Fkey_len := key_len;
  Self.Fref := ref;
  Self.Frows := rows;
  Self.Fextra := extra;
  Self.possible_keys := TStringList.Create;
end;

