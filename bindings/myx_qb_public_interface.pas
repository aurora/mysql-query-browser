function myx_reconstruct_embedded_sql(stripped: PMYX_Q_SQL_STRIPPED; sql: PAnsiChar): String;
var
  P: PAnsiChar;
begin
  P := _myx_reconstruct_embedded_sql(stripped, sql);
  if P = nil then
    Result := ''
  else
    Result := String(P);
  g_free(P);
end;

constructor TMYX_EXPLAIN_ROW.Create(id: String; select_type: String; table: String; join_type: String; key: String; key_len: String; ref: String; rows: String; extra: String);
