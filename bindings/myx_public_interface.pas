constructor TMYX_MYSQL_ERROR_MSG.Create(level: MYX_QUERY_ERROR_LEVEL; error: Integer; text: String);
begin
  inherited Create;
  Self.Flevel := level;
  Self.Ferror := error;
  Self.Ftext := text;
end;

constructor TMYX_MYSQL_ERROR_MSG.Create(ARecord: PMYX_MYSQL_ERROR_MSG);
begin
  if ARecord <> nil then
    Create(ARecord^.level, ARecord^.error, ConvertString(ARecord^.text))
  else
    Create(Default(MYX_QUERY_ERROR_LEVEL), Default(Integer), '');
  Self.record_pointer := nil;
  if ARecord <> nil then
  begin
  end;
end;

destructor TMYX_MYSQL_ERROR_MSG.Destroy;
begin
  if record_pointer <> nil then
  begin
    FreeCString(record_pointer^.text);
    FreeMem(record_pointer);
  end;
  inherited Destroy;
end;

function TMYX_MYSQL_ERROR_MSG.get_record_pointer: PMYX_MYSQL_ERROR_MSG;
var
  P: Pointer;
begin
  P := nil;
  if record_pointer = nil then
  begin
    GetMem(record_pointer, SizeOf(MYX_MYSQL_ERROR_MSG));
    FillChar(record_pointer^, SizeOf(MYX_MYSQL_ERROR_MSG), 0);
  end;
  record_pointer^.level := MYX_QUERY_ERROR_LEVEL(Self.Flevel);
  record_pointer^.error := cint(Self.Ferror);
  SetCString(record_pointer^.text, Self.Ftext);
  Result := record_pointer;
end;

procedure TMYX_MYSQL_ERROR_MSG.Assign(Source: TPersistent);
begin
  if Source is TMYX_MYSQL_ERROR_MSG then
    with TMYX_MYSQL_ERROR_MSG(Source) do
    begin
      Self.Flevel := Flevel;
      Self.Ferror := Ferror;
      Self.Ftext := Ftext;
